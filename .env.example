# Resend API Key pour l'envoi d'emails
# Créer un compte sur https://resend.com pour obtenir votre clé API
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email de destination pour le formulaire de contact
CONTACT_EMAIL=votre-email@example.com

# Configuration du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Jean-Michel Nougué-Lecocq - Magnétiseur"

# Google Maps API Key (côté serveur - ne pas mettre NEXT_PUBLIC_)
# Utilisé pour Places API (New) v1
# Activer "Places API (New)" dans Google Cloud Console
# Documentation: https://developers.google.com/maps/documentation/places/web-service/op-overview
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Place ID (public - peut être côté client)
# Trouver votre Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
NEXT_PUBLIC_GOOGLE_PLACE_ID=ChIJXXXXXXXXXXXXXXXXXXXXXXXX
